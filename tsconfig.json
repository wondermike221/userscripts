{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": false,
    "strict": false,
    "allowSyntheticDefaultImports": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "skipLibCheck": true,
    "lib": ["DOM", "ES6", "DOM.Iterable", "ScriptHost", "ESNext"]
  },
  "include": ["src/**/*"]
}
